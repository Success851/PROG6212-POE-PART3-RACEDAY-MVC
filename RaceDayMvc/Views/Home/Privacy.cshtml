@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">RaceDay Privacy Policy</h1>
        <p class="lead text-muted">
            Your privacy and personal information matter to us.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h3>1. Introduction</h3>
            <p>
                RaceDay is an event management system designed to help
                participants register for running, walking and cycling
                events. This policy explains how personal information
                is collected, used and protected when using the system.
            </p>

            <hr />

            <h3>2. Information We Collect</h3>
            <p>When using RaceDay, the system may collect:</p>
            <ul>
                <li>First name and surname.</li>
                <li>Email address and contact number.</li>
                <li>Account login information.</li>
                <li>Event registration and category details.</li>
                <li>Race results, finishing times and positions.</li>
            </ul>

            <hr />

            <h3>3. How We Use Your Information</h3>
            <p>Your information is used to:</p>
            <ul>
                <li>Create and manage participant accounts.</li>
                <li>Allow participants to register for events.</li>
                <li>Help organisers manage events and participants.</li>
                <li>Record and display race results.</li>
                <li>Improve the functionality of the RaceDay system.</li>
            </ul>

            <hr />

            <h3>4. Account Security</h3>
            <p>
                RaceDay uses account authentication to control access
                to participant and organiser features. Users should
                keep their login details confidential and avoid
                sharing their passwords.
            </p>

            <hr />

            <h3>5. Protection of Personal Information</h3>
            <p>
                RaceDay aims to protect personal information from
                unauthorised access, loss or misuse. Access to certain
                information is restricted according to the user's
                account role.
            </p>

            <hr />

            <h3>6. User Responsibilities</h3>
            <p>
                Users are responsible for providing accurate information
                when registering and updating their profiles. Users
                should also keep their account details secure.
            </p>

            <hr />

            <h3>7. Changes to This Policy</h3>
            <p>
                This Privacy Policy may be updated when improvements
                are made to the RaceDay system.
            </p>

            <hr />

            <h3>8. Contact Information</h3>
            <p>
                For questions about this Privacy Policy or the handling
                of information within this student project, please
                contact the RaceDay system administrator.
            </p>

            <div class="alert alert-success mt-4 mb-0">
                <strong>RaceDay:</strong> Every step counts. Your privacy matters.
            </div>

        </div>
    </div>

</div>
