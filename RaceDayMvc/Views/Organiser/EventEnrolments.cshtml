@model List<RaceDayMvc.Models.OrganiserEnrolmentViewModel>

@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-4">
    <h2>Event Enrolments</h2>
    <p>View participants registered for this event.</p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">
                    No participants have enrolled in this event yet.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Enrolment ID</th>
                                <th>Participant</th>
                                <th>Email</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.EnrolmentID</td>
                                    <td>
                                        @item.Participant.FirstName
                                        @item.Participant.LastName
                                    </td>
                                    <td>@item.Participant.Email</td>
                                    <td>@item.Category.CategoryName</td>
                                    <td>@item.EnrolmentDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Status</td>
                                    <td>
                                        @if (item.Status == "Enrolled")
                                        {
                                            <a class="btn btn-primary btn-sm"
                                               asp-controller="Organiser"
                                               asp-action="RecordResult"
                                               asp-route-enrolmentId="@item.EnrolmentID">
                                                Record Result
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>

