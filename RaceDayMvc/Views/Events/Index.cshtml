@model List<RaceDayMvc.Models.Event>
@using RaceDayMvc.Models

@{
    ViewData["Title"] = "Upcoming Events";

    var categoriesByEvent =
        ViewBag.CategoriesByEvent as Dictionary<int, List<Category>>;

    var role = Context.Session.GetString("Role");
    var isOrganiser = string.Equals(
        role,
        "organiser",
        StringComparison.OrdinalIgnoreCase);
}

<h2 class="mb-4">Upcoming Events</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <p>No events are currently available.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.EventType.Equals("Run", StringComparison.OrdinalIgnoreCase) ||
                                 item.EventType.Equals("Running", StringComparison.OrdinalIgnoreCase))
                            {
                                <img src="~/Images/Running.png" alt="Running"
                                     style="width:90px; height:65px; object-fit:cover;" />
                            }
                            else if (item.EventType.Equals("Walk", StringComparison.OrdinalIgnoreCase) ||
                                     item.EventType.Equals("Walking", StringComparison.OrdinalIgnoreCase))
                            {
                                <img src="~/Images/Walking.png" alt="Walking"
                                     style="width:90px; height:65px; object-fit:cover;" />
                            }
                            else if (item.EventType.Equals("Cycle", StringComparison.OrdinalIgnoreCase) ||
                                     item.EventType.Equals("Cycling", StringComparison.OrdinalIgnoreCase))
                            {
                                <img src="~/Images/Cycling.png" alt="Cycling"
                                     style="width:90px; height:65px; object-fit:cover;" />
                            }
                        </td>

                        <td>@item.EventName</td>
                        <td>@item.EventDate.ToShortDateString()</td>
                        <td>@item.Location</td>
                        <td>@item.DistanceKm km</td>
                        <td>@item.EventType</td>

                        <td>
                            @if (categoriesByEvent != null &&
                                 categoriesByEvent.ContainsKey(item.EventID) &&
                                 categoriesByEvent[item.EventID].Count > 0)
                            {
                                @if (!isOrganiser)
                                {
                                    <form asp-controller="Events"
                                          asp-action="Enrol"
                                          method="post">

                                        <input type="hidden"
                                               name="eventId"
                                               value="@item.EventID" />

                                        <select name="categoryId"
                                                class="form-select"
                                                required>
                                            @foreach (var category in categoriesByEvent[item.EventID])
                                            {
                                                <option value="@category.CategoryID">
                                                    @category.CategoryName
                                                    (@category.DistanceKm km)
                                                </option>
                                            }
                                        </select>

                                        <button type="submit"
                                                class="btn btn-success mt-2">
                                            Enrol
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span>Categories available</span>
                                }
                            }
                            else
                            {
                                <span>No categories available</span>
                            }
                        </td>

                        <td>
                            @if (isOrganiser)
                            {
                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-warning btn-sm mb-1">
                                    Edit Event
                                </a>



                                <a asp-controller="Organiser"
                                   asp-action="CreateCategory"
                                   asp-route-eventId="@item.EventID"
                                   class="btn btn-info btn-sm mb-1">
                                    Create Category
                                </a>

                                <form asp-controller="Events"
                                      asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    <input type="hidden" name="id" value="@item.EventID" />

                                    <button type="submit" class="btn btn-danger btn-sm mb-1">
                                        Delete Event
                                    </button>

                                </form>

                                <a asp-controller="Organiser"
                                   asp-action="EventEnrolments"
                                   asp-route-eventId="@item.EventID"
                                   class="btn btn-primary btn-sm mb-1">
                                    View Participants
                                </a>
                            }
                            else if (categoriesByEvent != null &&
                                     categoriesByEvent.ContainsKey(item.EventID) &&
                                     categoriesByEvent[item.EventID].Count > 0)
                            {
                                <span>Select a category to enrol</span>
                            }
                            else
                            {
                                <span>Not available</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
